# Credenciales y proveedor de IA (Ornith / Gateway UAB)
ORNITH_API_KEY=
ORNITH_API_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1
ORNITH_MODEL=ornith
ORNITH_TIMEOUT_SECONDS=600
ORNITH_REASONING_EFFORT=none

# API SOC simulada Deloitte (puerto por defecto: 8000; NO usar el puerto de Streamlit 8501)
SOC_API_URL=http://127.0.0.1:8000

# Persistencia separada. Rutas relativas a la raíz del proyecto.
SOC_DB_PATH=tickets.sqlite3
SOC_N2_DB_PATH=tickets_n2.sqlite3
SOC_RESPONSE_DB_PATH=soc_response.sqlite3

# Ensayo de la hackathon: identidades simuladas y contención solo en API local.
# false permite consultar y planificar, sin registrar decisiones ni ejecutar.
SOC_DEMO_MODE=true
